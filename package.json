    "check:layers": "node scripts/check-layer-cover.js",
    "check:login": "node scripts/check-login-screen.js",
    "check:keyboard": "node scripts/check-keyboard.js",
    "check:a11y": "node scripts/check-a11y.js",
    "check:board": "node scripts/check-board.js",
    "check:console": "node scripts/check-console.js",
    "check:avatar": "node scripts/check-ai-avatar.js",
    "check:screenshare": "node scripts/check-screenshare.js",
    "check:wake": "node scripts/check-wake-scope.js",
    "check:caption": "node scripts/check-caption-line.js",
    "check:theme": "node scripts/check-theme.js",
    "check:invite": "node scripts/check-invite.js",
    "check:golden": "node scripts/check-golden.js",
    "check:files": "node scripts/check-files.js",
    "check:all": "node scripts/check-all.js"
  },
  "dependencies": {
    "mediasoup": "^3.26.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mediasoup-client": "^3.23.1",
    "socket.io-client": "^4.8.3"
  },
  "license": "MIT",
  "keywords": [
    "webrtc",
    "mediasoup",
    "sfu",
    "video-conference",
    "sctp",
    "simulcast"
  ]
}
