{
  "name": "simple-tencent-meeting",
  "version": "1.0.0",
  "description": "基于 WebRTC 与 mediasoup 的多人视频会议系统（毕业设计）：SFU 架构 + 屏幕共享协作批注 + H5 远程协助 + 服务器侧录制 + 实时观测面板，零前端框架零业务 SDK",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test-signaling.js",
    "start:sfu": "node sfu/server.js",
    "test:sfu": "node scripts/test-sfu-signaling.js",
    "test:store": "node scripts/test-store.js",
    "test:shutdown": "node scripts/test-shutdown.js",
    "admin:list": "node scripts/admin.js list",
    "admin:grant": "node scripts/admin.js grant",
    "admin:revoke": "node scripts/admin.js revoke",
    "admin:adduser": "node scripts/admin.js adduser",
    "admin:passwd": "node scripts/admin.js passwd",
    "admin:purge": "node scripts/admin.js purge-tests",
    "test:smoke": "node scripts/test-sfu-client-smoke.js",
    "build:sfu-vendor": "esbuild ./node_modules/mediasoup-client/lib/index.js --bundle --format=iife --global-name=mediasoupClient --outfile=sfu/public/vendor/mediasoup-client.js",
    "start:demo": "node scripts/start-demo.js",
    "test:record": "node -e \"const{spawn}=require('child_process');const p=spawn(process.execPath,['sfu/server.js'],{env:{...process.env,TEST_RECORD:'1',TEST_RECORD_EXIT:'1'},stdio:'inherit'});p.on('exit',c=>process.exit(c||0))\"",
    "test:asr-live": "node scripts/run-asr-live.js",
    "test:asr-soak": "node scripts/run-asr-live.js --soak",
    "bench": "node scripts/bench.js",
    "bench:signaling": "node scripts/bench-signaling.js",
    "start:lan": "node scripts/start-lan.js",
    "test:turn": "node scripts/test-turn.js",
    "soak": "node scripts/soak.js",
    "watch": "node scripts/watch.js",
    "doctor": "node scripts/doctor.js",
    "test:ai": "node scripts/test-ai.js",
    "test:asr": "node scripts/test-asr.js",
    "test:watch": "node scripts/test-watch.js",
    "test:nets": "node scripts/test-nets.js",
    "test:crossnet": "node scripts/test-crossnet.js",
    "test:stun": "node scripts/stun-probe.js --selftest",
    "test:fileview": "node scripts/test-fileview.js",
    "test:files": "node scripts/test-files.js",
    "check:toggle": "node scripts/check-toggle-motion.js",
    "check:think": "node scripts/check-thought-line.js",
    "check:glow": "node scripts/check-glow-trail.js",
    "check:pill": "node scripts/check-pill-rise.js",
    "check:visual": "node scripts/check-visual-pass.js",
    "check:icons": "node scripts/check-icon-sweep.js",
    "check:dock": "node scripts/check-dock-fit.js",
    "test:tts": "node scripts/test-tts.js",
    "test:e2e-media": "node scripts/test-e2e-media.js",
    "test:e2e-reconnect": "node scripts/test-e2e-reconnect.js",
    "test:voice-longrun": "node scripts/test-voice-longrun.js",
    "test:room-actions": "node scripts/test-room-actions.js",
    "test:quiet-mic": "node scripts/test-quiet-mic.js",
    "review:meeting": "node scripts/review-meeting.js",
    "review:office": "node scripts/review-office.js",
    "test:office": "node scripts/review-office.js --selftest",
    "test:review": "node scripts/review-meeting.js --selftest",
    "bench:asr": "node scripts/bench-asr-accuracy.js",
    "bench:asr-golden": "node scripts/bench-asr-golden.js",
    "bench:asr-multi": "node scripts/bench-asr-multi.js",
    "bench:innerhtml": "node scripts/bench-innerhtml.js",
    "test:qwen": "node scripts/test-qwen.js",
    "test:ai-brain": "node scripts/test-ai-brain.js",
    "verify:ai": "node scripts/verify-ai-live.js",
    "verify:board": "node scripts/verify-board-live.js",
    "verify:voice": "node scripts/verify-voice-latency.js",
    "bench:tts": "python scripts/bench-tts.py",
    "bench:gpu": "python scripts/gpu-bench-once.py both",
    "ai:chat": "node scripts/chat.js",
    "ai:summarize": "node scripts/summarize.js",
    "ai:agent": "node scripts/agent.js",
    "test:agent": "node scripts/test-agent.js",
    "test:e2e": "node scripts/test-e2e-remote-desktop.js",
    "publish:mesh": "node scripts/publish.js",
    "publish:tunnel": "node scripts/publish.js --tunnel",
    "test:publish": "node scripts/test-publish.js",
    "agent": "node agent/index.js",
    "cdp": "node agent/cdp.js",
