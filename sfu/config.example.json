{
  "port": 3001,
  "maxMembers": 8,
  "workerCount": 1,          // mediasoup Worker 进程数（SFU 深造：多核横向扩展，默认 1；多核机器可 2~4）
  // ★ 09-24 账号数据库位置（node:sqlite）。不写则用默认 sfu/data/meeting.db；
  //   环境变量 DB_FILE 优先级更高（测试脚本用它指到临时文件，避免写脏真实数据）。
  "dbFile": "data/meeting.db",
  // ★ 09-24 管理员钦定：填了它，这个用户名注册时直接是 admin（不填则"首个注册的账号"自动成为 admin）
  "adminUsername": "your-admin-name",
  // ★ 09-29 G6-③ 生产化：密码强度与登录锁定（环境变量 AUTH_PASSWORD_MINLEN / AUTH_LOCK_MS 优先）
  "passwordMinLen": 8,        // 注册密码下限位数（另要求字母/数字/符号至少两类；只管新注册）
  "loginLockMs": 900000,      // 同一账号连续错 5 次后的锁定时长（默认 15 分钟；重启服务器清零）
  "listenIp": "0.0.0.0",
  // ★ 2026-10-06 跨网这件事的"配一次就长期对"：写 "auto" 而不是写死一个 IP。
  //   ▎写死 IP 的真实下场是它会漂——换 WiFi、重连路由器、休眠重起都会换地址，
  //     而 mediasoup 照旧把旧地址告诉浏览器：本机全好、别人黑屏、零报错（坑 36）。
  //     服务器现在每次启动都会核对"这个地址还在不在本机网卡上"，不在就自动改用真实网卡 IP，
  //     但那只是兜底；把配置写成 "auto" 才是**不需要被兜底**的状态。
  //   ▸ 什么时候才该写死：云主机有弹性公网 IP（那个地址不会自己变），或容器里由编排注入。
  //   判据与排序在 sfu/nets.js：优先"名字像真的对外网口 + 私网段"，
  //   会主动避开 VirtualBox / WSL / Docker 那种"本机 ping 得通、别人根本路由不到"的地址。
  "announcedIp": "auto",
  "rtcMinPort": 40000,
  "rtcMaxPort": 49999,
  // ★ 2026-10-09（K1 跨网主线）媒体端口形态：0 = 沿用上面的随机端口段；>0 = 全服务器共用这一个号。
  //   ▎为什么要固定端口：默认形态下每条媒体通道都在 40000-49999 里**随机要一对 UDP 端口**，
  //     于是"让别的网络也能进会"需要转发**一整段**端口（家用路由器多半做不到），
  //     而且只有 UDP —— 公司/校园网把 UDP 全封掉时完全没有退路。
  //   ▸ 配成 4443 之后：整个 Worker 的媒体共用 UDP+TCP 同号 4443（WebRtcServer），
  //     · 路由器/防火墙只需一条映射（UDP 4443 + TCP 4443 → 这台机器）；
  //     · UDP 被封的网络会自动退到 TCP 候选（ICE 层面，不改客户端代码）；
  //     · 想做"443 直接映射"的（很多人只放通 443）也只需要一条规则。
  //   ▸ 什么时候别开：这个号被别的程序占了（起不来会**自动退回随机段**并在启动日志说实话），
  //     或 workerCount>1（第 i 个 Worker 用 base+i，所以 4443 起要连着几个号都空）。
  "rtcServerPort": 4443,
  "iceServers": [
    {
      "urls": "stun:stun.l.google.com:19302"
    },
    {
      "urls": "turn:openrelay.metered.ca:80",
      "username": "openrelayproject",
      "credential": "openrelayproject"
    },
    {
      "urls": "turn:openrelay.metered.ca:443",
      "username": "openrelayproject",
      "credential": "openrelayproject"
    },
    {
      "urls": "turn:openrelay.metered.ca:443?transport=tcp",
      "username": "openrelayproject",
      "credential": "openrelayproject"
    }
  ],
  "roomTtlSec": 60,
  // ★ 09-28 AI 语音对话（服务端 whisper 转写）：
  //   asrModel      —— 转写模型。small(默认：常驻 worker 下每段只多约 2s，明显少错字，
  //                    实测"产品评审会"tiny 转成"平省会"、small 全对) / base / tiny(最快最省内存)。
  //                    环境变量 WHISPER_MODEL 优先级更高。
  //   asrPipePortBase —— ★ 2026-10-04g AI 听觉管线的 RTP 端口段起点（每路占 2 个，段宽 500 路）。
  //                    默认 26000：必须在 Windows 动态端口区（49152-65535）与 Linux 动态区
  //                    （32768+）之外，否则出站连接会随机占走端口 → ffmpeg bind 失败秒崩
  //                    ×5 → "对话一段时间字幕就断了"（今日四场真实会议日志全部实锤）。
  //                    也不要撞 mediasoup 的 rtcMinPort~rtcMaxPort（默认 40000-49999）。
  //   asrSegmentSec —— 每段录音长度秒数（2~15，默认 4）。越小越灵敏、越大上下文越完整。
  //                    ★ 2026-10-03e 实测：ffmpeg 分段文件写满才落盘，字幕延迟下限=说完→窗口
  //                    边界——**GPU 转写（torch CUDA 版）建议 2**（最坏等待 4s→2s，半句字幕
  //                    刷新也更勤，碎片由句内去重兜住）；CPU 转写 2.2s/段，保持 4。
  //                    环境变量 ASR_SEGMENT_SEC 优先级更高；并发上限见 ASR_CONCURRENCY（默认 2）。
  //   aiChatWindowSec —— ★ 追问窗口（默认 **0 = 关**）。设成正数 N：AI 答完之后 N 秒内大家
  //                      继续说**不用再喊"小明"**，当成追问继续聊（多轮对话）。
  //   ▎为什么默认关掉（2026-10-06）：真实会议的麦克风是常开的，喊过一次名字之后每次应答
  //                      都把窗口往后推，只要有人不停说话窗口就永远不关，
  //                      **AI 会把整场会都当成对自己说的**（房间 286716 实测：
  //                      21 条转写里 4 条提到名字，AI 答了 18 次）。
  //                      "和 AI 单独讨论纪要"那种场景再设回 20；正常开会保持 0。
  //   aiProactiveSay  —— ★ AI 会不会**没被叫到就自己插话**（默认 false）。
  //                      true = 看到"没人认领的行动项/新风险"就主动播报一句。
  //                      默认关的理由同上：那是没有任何人叫它、它自己开口，
  //                      而行动项是规则+LLM 推断的，误报时用户只看到"它乱说话"。
  //                      看板照旧记账，关掉的只是"说"。（env AI_PROACTIVE_SAY=1 同效）
  //   aiAskTailSec   —— ★ 被分段切断的**半句**续接秒数（默认 6，最小 2）。
  //                      「小明，把纪要生成一下」常被 2s 分段切成「小明。」+「把纪要生成一下。」，
  //                      纯唤醒模式下后半句没名字会被漏掉。这一条**只接一句、用完作废、不顺延**，
  //                      所以它不是上面那个窗口的替代品，也不会让 AI 接管会议。
  //   asrMinPeakDb —— ★ 2026-10-05 夜 能量闸（dBFS 峰值，默认 -62；env ASR_MIN_PEAK_DB 优先）。
  //                    这条阈值已经被真机改过三次：-45（拿 TTS 全幅音色假设）→ -55（房间 134156
  //                    实测笔记本麦 -46~-50）→ **-62**（房间 283648 实测同一个人 -56~-65，
  //                    66 秒里 8 段被当静音删掉 = 用户报的"说了半天没字幕"）。
  //                    安静房间噪声底在 -70 以下、纯静音 -99，所以 -62 仍能拦住噪音。
  //                    ▸ 闸后还有"按实测峰值比例增益"（目标 -8dBFS，上限 +40dB），
  //                    两把尺子要一起动：只放宽闸不提增益，送进模型的就还是耳语 → 全是错字。
  //   aiTtsLocalWait —— ★ 本地 Qwen3-TTS 是否抢实时播报（默认 false = **不加载那个 worker**）。
  //                    2026-10-05 取证：全天 157 次播报 engine 全是 edge（微软晓晓），千问 0 次；
  //                    而它 GPU 上 RTF≈4.1（合成比播放慢），预热还白占 ~1.5GB 显存 + 启动 ~20s。
  //                    设 true 才预热并使用自持音色（Edge 不可达的机器可以考虑）。
  //   asrRefine —— ★ 2026-10-07 整句重转（默认开；env ASR_REFINE=0 强制关）。
  //                    管线本来就把语音切成 2s 一段**分别**转写再拼句子，而中文的词会被
  //                    切在段边界上（实跑打印过的原话：「服务器」→「服务。」+「起负载」、
  //                    「生成」→「升」+「乘」、「评审会」→「评审。」+幻觉「怎会？」）。
  //                    开启后：定稿时把**这一句的整段音频**一次喂回模型，用它自己标好
  //                    标点的那句话替换拼接结果 —— 字幕因此是"一整句"而不是一串碎片。
  //                    ▸ 一次对照实验（同一批生产函数、同一段音频、本机 Qwen3-ASR·GPU）：
  //                      逐字全对的句子 1/6 → 3/6，多余字数 6 → 4，模型总耗时 4.34s → 3.22s。
  //                      省时间是因为一次调用少付一次固定开销、也不再重复吐同一个词。
  //                    ▸ 代价：定稿多等一次整句推理（实测 +0.4~0.7s），⏱ 读数会诚实上移。
  //   asrRefineMaxSec —— 整句重转最多攒多少秒音频（默认 12，钳 3~20；env ASR_REFINE_MAX_SEC）。
  //                    上限是为了**内存有界**（16k 单声道 = 32000 字节/秒，12s ≈ 384KB/人）；
  //                    超出就不再留声，那一句退回拼接结果（宁可少修，不能把人说的话弄丢）。
  // ★ "此刻有没有人在说话"的两条硬安全线（只有 env，没有配置键——它们不是给用户调的产品参数，
  //   是排障与 A/B 时的对照开关；判据本体在 sfu/ai/asr.js 的 createVoiceTracker）：
  //   ASR_VOICE_DEAF_CEIL（默认 -42）—— 阈值**绝不比这更迟钝**。房间底噪 -43 时旧版仍用 -50，
  //                    于是噪声本身被当成"有人在说"，静音永不确认 ⇒ 三句话粘成一条 blob
  //                    （2026-10-07 test:asr-live 实测：180/180 帧底噪判有声）。
  //   ASR_VOICE_SENSITIVE_FLOOR（默认 -74）—— 阈值**绝不比这更灵敏**，免得一次呼吸被当语音。
  //   ASR_VOICE_ADAPT=0 —— 整条自适应关掉，退回单一绝对阈值（ASR_FLUSH_DB）。
  "asrModel": "small",
  "asrSegmentSec": 4,
  "asrMinPeakDb": -62,
  //   asrQwenWorkers —— ★ 2026-10-07 H1 本地 Qwen3-ASR 的 worker 池大小（默认 1，env ASR_QWEN_WORKERS）。
  //                    一个 worker 就是一条**串行队列**：多人会议里第 N 个人的字幕要排在前面所有人后面。
  //                    `npm run bench:asr-multi` 实测（RTX 4060 Laptop 8GB，8 路并发 + 开"忙时让路"，
  //                      并且**同一场次里跑了 1→2→1 三次**以排除"GPU 越跑越快"的顺序偏差）：
  //                      1 个 worker：分段 p95 3.14~3.18s、吞吐 2.59~2.62 次/秒
  //                      2 个 worker：分段 p95 **1.78s**、吞吐 **4.30 次/秒**（≈1.65 倍）
  //                    ▸ 代价说清：**一个 worker 常驻 ≈1.9GB 显存**（nvidia-smi 实测两个同跑时总占用 5.0GB）。
  //                      8GB 卡上"2 个 ASR + 浏览器 + whisper 兜底"是紧的，显存不够的后果不是报错，
  //                      而是**引擎静默回落 CPU**（那时所有延迟数字都变慢且没人告诉你，10-04e 实测过）。
  //                    ▸ 所以默认 1（= 单机/双人会议今天的表现）；**4 人以上常开会且卡 ≥12GB 再配 2**。
  "asrQwenWorkers": 1,
  "asrRefine": true,
  "asrRefineMaxSec": 12,
  "aiTtsLocalWait": false,
  // ★ 2026-10-01 ASR 引擎可插拔（试 Qwen3-ASR）：auto（默认）= 配了 DASHSCOPE_API_KEY 且
  //   探测通过就优先 Qwen3-ASR-Flash（DashScope 云端，52 语言/方言，免本地 GPU），
  //   单段失败自动回落 whisper 常驻 worker；whisper=强制本地；qwen=强制云端。
  //   key 放项目根 .env：DASHSCOPE_API_KEY=sk-xxx（引擎只在服务端，绝不下发浏览器）。
  "asrEngine": "auto",
  "aiChatWindowSec": 0,
  "aiProactiveSay": false,
  "aiAskTailSec": 6,
  // ★ 09-30c 服务端神经语音（Edge TTS，零 npm 依赖）：服务器合成 MP3 下发，AI 声音不再
  //   依赖用户本机音色（老 SAPI = "AI 味"的根源）。启动自动探测端点可达性，
  //   不可达自动回落浏览器 speechSynthesis（AI_TTS=0 可强制关闭）。
  //   aiTtsVoice —— 音色名（默认 zh-CN-XiaoxiaoNeural 晓晓；可换 zh-CN-YunxiNeural 云希等）。
  "aiTtsVoice": "zh-CN-XiaoxiaoNeural",
  // ★ 2026-10-02 本地 Qwen3-TTS（自持音色）要不要用于**实时播报**。默认 false：
  //   本机 CPU 实测合成一句要 12~44s（答案 3s 就上屏、声音 47s 才到），
  //   对话里"慢半拍的好声音"不如"马上能听到的普通声音"，所以默认让浏览器朗读出声。
  //   true = 让本地神经音色抢这条链（配 Edge 不可达时想用自持音色/做录音产物才开）。
  "aiTtsLocalWait": false,
  // ★ 2026-10-02 慢引擎下的**播报字数预算**：超过就不再多念（CPU 神经音色 RTF>1，
  //   长答案念到一半用户早就不听了）。默认 48 字。
  //   ▸ 2026-10-09 这条约束的**执行方式**改了：以前是把超预算的句子按字数拦腰截断，
  //     听起来就是"话说一半然后没声"；现在首句永远整句念，之后的句子放不下就整句不念
  //     （文字气泡里始终是全的）。同时语音问答那一路在生成时就被要求"结论进第一句"。
  "aiTtsMaxChars": 48,
  // ★ 2026-10-09 模型输入的峰值增益（安静麦克风的救赎）：把太轻的语音按比例提到目标峰值，
  //   上限是硬钳（再吵也不许把底噪放大成响噪）。两处管线（分段 / 整句重转）共用同一个算式，
  //   而 `npm run bench:asr-golden` 量的也是**这一份**音量，所以调它=调生产喂给模型的东西。
  //   env 同名可覆：ASR_GAIN_TARGET_DB / ASR_GAIN_CAP_DB。
  "asrGainTargetDb": -8,
  "asrGainCapDb": 40,
  // ★ 09-24 C4 房间内令牌（room token）：会议内容接口（/api/captions、/api/minutes、/minutes/*）
  //   的门禁开关。默认 true（安全默认值）：进房时给每个成员（含游客）发一张只对本房间有效的
  //   签名令牌，读内容要带它。设成 false 则退回旧行为（这些接口开放）——仅供本地调试/教学对比，
  //   公网部署**不要**关。
  "roomTokenRequired": true,
  // 房间内令牌有效期（秒），默认 86400 = 24 小时。无状态令牌：服务器重启后依然有效
  //   （不存内存），但无法单独吊销——换掉 sfu/data/room-secret 会让所有已签发令牌立即失效。
  // 环境变量 ROOM_TOKEN_TTL_SEC 优先级更高（信令测试用它造"已过期"的令牌，传 -1）。
  "roomTokenTtlSec": 86400,
  "videoSvc": false,
  "https": {
    "enabled": true,
    "port": 3443,
    "autoSelfSigned": true
  }
}
