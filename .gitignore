# 密钥（★ 09-24：DeepSeek API key 放 .env，绝不入库）
.env
.env.*

# ★ 09-24 跨网发布配置：可能含 TURN 的 username/credential，绝不入库
#   （根目录这份是你的真配置；publish-mesh 下那份由 scripts/publish.js 生成）
mesh.config.json
publish-mesh/mesh.config.json
publish-mesh/package-lock.json

# 依赖
node_modules/

# 运行时产物（不入库：每人自己的数据与录制）
sfu/recordings/
sfu/config.json.bak-*
.reasonix/
reasonix.toml
sfu/captions/
sfu/minutes/
sfu/logs/
sfu/boards/
sfu/users.json
# 迁移时对旧账号文件的改名备份（保留在磁盘，但不必入库）
sfu/users.json.imported-*
sfu/users.json.bak-*
# ★ 09-24：账号/审计的 SQLite 运行时数据（meeting.db + 迁移产生的 .db-wal/.db-shm 一并挡住）
sfu/data/
sfu/config.json
sfu/tls/
*.log
public/vendor/          # 由 npm run build:sfu-vendor 重新生成
sfu/public/vendor/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# ★ 09-25 真浏览器验证的截图存证（体积大、可再生，不进版本库）
sfu/shots/
.mimosa/

# ★ 09-30：临时探针/调试脚本（下划线前缀 = 一次性，跑完即弃）
#   加这条是因为我用 `git add -A` 时把 _probe-desk.js 一起提交了——
#   `add -A` 会把"我以为早删了"的临时文件也带上，所以用规则挡住它。
scripts/_*

# ★ 2026-10-02：本地大模型权重（4.1GB，ModelScope/HF 下载产物，用命令可再生）
#   为什么要挡：目录里自带的 .gitattributes 把 *.safetensors 声明成 LFS，
#   一次 `git add -A` 就把 25 个模型文件带进了索引——权重在磁盘上存了两份
#   （models/ + .git/lfs/objects 各 4.1G），而且别人 clone 时若没装 git-lfs，
#   拿到的只是 135 字节的指针文件（模型直接不可用）。下载命令写进 README，不入库。
models/

# Agent 会话数据（与 .mimosa/.reasonix 同类：本机产物，含绝对路径，不入库）
.workbuddy/

# Python 字节码缓存（worker 脚本跑一次就会生成，本机产物）
__pycache__/
*.pyc
